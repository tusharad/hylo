cabal-version: 3.4

name:           hylo
version:        0.1.0.0
synopsis:       Type-safe Haskell ORM using recursion schemes
description:    Please see the README on GitHub at <https://github.com/tusharad/hylo#readme>
category:       Database
homepage:       https://github.com/tusharad/hylo#readme
bug-reports:    https://github.com/tusharad/hylo/issues
author:         Tushar Adhatrao
maintainer:     tusharadhatrao@gmail.com
copyright:      2026 Tushar Adhatrao
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-doc-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/tusharad/hylo

common common-options
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Werror
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library hylo-core
  import: common-options
  visibility: public
  hs-source-dirs: src/core
  exposed-modules:
      Hylo.Backend.Capability
      Hylo.Core
      Hylo.Core.Changeset
      Hylo.Core.Codec
      Hylo.Core.Context
      Hylo.Core.Error
      Hylo.Core.Expr
      Hylo.Core.Key
      Hylo.Core.Nullable
      Hylo.Core.Schema
      Hylo.Core.Table
      Hylo.Core.Text
      Hylo.Core.Transaction
      Hylo.Core.TypeError
      Hylo.Core.TypeLevel.Nat
  build-depends:
      base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , deepseq >=1.4 && <2
    , text >=1.2 && <3
    , time >=1.9 && <2
    , uuid >=1.3 && <2
    , vector >=0.12 && <0.14

library hylo-sql
  import: common-options
  visibility: public
  hs-source-dirs: src/sql
  exposed-modules:
      Hylo.SQL
      Hylo.SQL.AST
      Hylo.SQL.Builder
      Hylo.SQL.Compiler.JoinFlattener
      Hylo.SQL.Query.Aggregate
      Hylo.SQL.Query.CTE
      Hylo.SQL.Query.Recursive
      Hylo.SQL.Query.Window
      Hylo.Core.Query
      Hylo.Core.Query.Monad
      Hylo.Core.Query.Pagination
  build-depends:
      base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , deepseq >=1.4 && <2
    , hylo:hylo-core
    , text >=1.2 && <3
    , transformers >=0.5 && <0.7
    , vector >=0.12 && <0.14

library hylo-pg
  import: common-options
  visibility: public
  hs-source-dirs: src/pg
  exposed-modules:
      Hylo.PG
      Hylo.PG.Codec.Binary
      Hylo.PG.Compiler.Aggregate
      Hylo.PG.Compiler.CTE
      Hylo.PG.Compiler.JoinFlattener
      Hylo.PG.Compiler.Lateral
      Hylo.PG.Compiler.SQL
      Hylo.PG.Compiler.Window
      Hylo.PG.Connection
      Hylo.PG.Error.Translation
      Hylo.PG.Hydration.Graph
      Hylo.PG.Mutation.Bulk
      Hylo.PG.Mutation.Changeset
      Hylo.PG.Mutation.Locking
      Hylo.PG.Mutation.Upsert
      Hylo.PG.Pool.Routing
      Hylo.PG.Search.Hybrid
      Hylo.PG.Search.RRF
      Hylo.PG.Streaming.Cursor
      Hylo.PG.Transaction.Hooks
      Hylo.PG.Transaction.Retry
      Hylo.PG.Transaction.Savepoint
      Hylo.PG.Vector
  build-depends:
      base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , deepseq >=1.4 && <2
    , hasql >=1.6 && <1.10
    , hasql-pool >=1.0 && <2
    , hasql-transaction >=1.1 && <2
    , hylo:hylo-core
    , hylo:hylo-sql
    , stm >=2.5 && <3
    , text >=1.2 && <3
    , time >=1.9 && <2
    , uuid >=1.3 && <2
    , vector >=0.12 && <0.14

library hylo-mysql
  import: common-options
  visibility: public
  hs-source-dirs: src/mysql
  exposed-modules:
      Hylo.MySQL
      Hylo.MySQL.Compiler
  build-depends:
      base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , hylo:hylo-core
    , hylo:hylo-sql
    , text >=1.2 && <3

library hylo-sqlite
  import: common-options
  visibility: public
  hs-source-dirs: src/sqlite
  exposed-modules:
      Hylo.SQLite
      Hylo.SQLite.Compiler
  build-depends:
      base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , hylo:hylo-core
    , hylo:hylo-sql
    , text >=1.2 && <3

library hylo-redis
  import: common-options
  visibility: public
  hs-source-dirs: src/redis
  exposed-modules:
      Hylo.Redis
  build-depends:
      base >=4.7 && <5
    , hylo:hylo-core

library
  import: common-options
  hs-source-dirs: src/main
  exposed-modules:
      Hylo
      Hylo.AI.Policy.RLS
      Hylo.AI.QueryTool
      Hylo.AI.Schema.JSON
      Hylo.Migrate.AST
      Hylo.Migrate.Catalog
      Hylo.Migrate.Catalog.PG
      Hylo.Migrate.CodeGen
      Hylo.Migrate.Diff
      Hylo.Migrate.Linter
      Hylo.Migrate.Runner.Shadow
  build-depends:
      aeson >=2.0 && <3
    , aeson-qq >=0.8 && <1
    , base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , deepseq >=1.4 && <2
    , hasql >=1.6 && <1.10
    , hasql-pool >=1.0 && <2
    , hasql-transaction >=1.1 && <2
    , hylo:hylo-core
    , hylo:hylo-mysql
    , hylo:hylo-pg
    , hylo:hylo-redis
    , hylo:hylo-sql
    , hylo:hylo-sqlite
    , scientific ==0.3.*
    , stm >=2.5 && <3
    , template-haskell >=2.16 && <3
    , text >=1.2 && <3
    , time >=1.9 && <2
    , uuid >=1.3 && <2
    , vector >=0.12 && <0.14

executable hylo-exe
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , hylo
    , hylo:hylo-core

test-suite hylo-test
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
      Hylo.AI.QueryToolSpec
      Hylo.Backend.CapabilitySpec
      Hylo.Core.ChangesetSpec
      Hylo.Core.CodecSpec
      Hylo.Core.TableSpec
      Hylo.Core.TransactionSpec
      Hylo.Core.TypeErrorSpec
      Hylo.Migrate.DiffSpec
      Hylo.Migrate.LinterSpec
      Hylo.PG.Compiler.AggregateSpec
      Hylo.PG.Compiler.CTESpec
      Hylo.PG.Compiler.JoinFlattenerSpec
      Hylo.PG.Compiler.LateralSpec
      Hylo.PG.Compiler.WindowSpec
      Hylo.PG.Mutation.BulkSpec
      Hylo.PG.Mutation.ChangesetSpec
      Hylo.PG.Mutation.UpsertSpec
      Hylo.PG.RealPostgresSpec
      Hylo.PG.Search.HybridSpec
      Hylo.PG.Streaming.CursorSpec
      Hylo.PG.Transaction.RetrySpec
      Hylo.PG.VectorSpec
      Hylo.SQL.BuilderSpec
      Hylo.Test.Docker
      Hylo.Test.ShouldNotTypecheck
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      QuickCheck >=2.14
    , aeson >=2.0 && <3
    , aeson-qq >=0.8 && <1
    , base >=4.7 && <5
    , bytestring >=0.10 && <0.13
    , containers >=0.6 && <0.8
    , deepseq >=1.4
    , hasql >=1.6 && <1.10
    , hasql-pool >=1.0 && <2
    , hasql-transaction >=1.1 && <2
    , hspec >=2.11
    , hylo
    , hylo:hylo-core
    , hylo:hylo-mysql
    , hylo:hylo-pg
    , hylo:hylo-redis
    , hylo:hylo-sql
    , hylo:hylo-sqlite
    , process >=1.6 && <2
    , scientific ==0.3.*
    , should-not-typecheck >=2.1
    , stm >=2.5 && <3
    , template-haskell >=2.16 && <3
    , text >=1.2 && <3
    , time >=1.9 && <2
    , uuid >=1.3 && <2
    , vector >=0.12 && <0.14
